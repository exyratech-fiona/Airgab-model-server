# Copy to .env and fill in. Nothing here is read at build time — only by
# docker-compose when you run `docker compose up`.
#
# The three *_MODEL_FILE values are REQUIRED (compose refuses to start a
# service without its file set — see the ":?" in docker-compose.yml). Every
# other value has a working default.

# ---- which image to run (leave as-is unless you built a different tag) ----
LOCAL_LLM_IMAGE=dlabssg/local-llm:latest

# ---- LLM (chat / completion) ----
# The GGUF file's name under ./models — NOT a path, just the filename.
LLM_MODEL_FILE=
# What the model calls itself in API responses (the "model" field). Cosmetic,
# but worth setting to something the calling application expects.
LLM_MODEL_NAME=llm
LLM_PORT=8094
LLM_CTX=8192
# Match this to the CPU you're actually running on (nproc), not the build box.
LLM_THREADS=8
LLM_PARALLEL=1
LLM_MEM_LIMIT=16g

# ---- Embeddings ----
EMBED_MODEL_FILE=
EMBED_MODEL_NAME=embed
EMBED_PORT=8090
EMBED_CTX=4096
EMBED_THREADS=4
EMBED_MEM_LIMIT=3g
# mean: BGE-M3, nomic-embed-text.  cls: BGE-large-en-v1.5.
# Wrong value != an error — it silently degrades embedding quality. Check the
# embedding model's card/README for which pooling it expects.
EMBED_POOLING=mean

# ---- Reranker (cross-encoder) ----
RERANK_MODEL_FILE=
RERANK_MODEL_NAME=reranker
RERANK_PORT=8092
RERANK_CTX=4096
RERANK_THREADS=4
RERANK_MEM_LIMIT=3g
