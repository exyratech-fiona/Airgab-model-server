# Copy to .env and fill in. Nothing here is read at build time — only by
# docker-compose when you run `docker compose up`.
#
# The three *_MODEL_FILE values are REQUIRED (compose refuses to start a
# service without its file set — see the ":?" in docker-compose.yml). Every
# other value has a working default.
#
# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  THREE DEPLOYMENT PROFILES — pick the one that matches your hardware:  ║
# ║                                                                         ║
# ║  1. CPU, single socket  →  set model files + threads. Done.            ║
# ║  2. CPU, multi-socket   →  also set NUMA_ENABLED=1 + CPUSET.          ║
# ║  3. GPU                 →  set cuda image + GPU_LAYERS, use --profile. ║
# ║                                                                         ║
# ║  See examples at the bottom of this file.                               ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ---- which image to run ----
# CPU-only (default, ~200 MB):
LOCAL_LLM_IMAGE=dlabssg/local-llm:latest
# GPU/CUDA (build with CUDA=1 bash build-and-push.sh, ~5 GB):
# LOCAL_LLM_IMAGE=dlabssg/local-llm:cuda12

# ---- LLM (chat / completion) ----
# The GGUF file's name under ./models — NOT a path, just the filename.
LLM_MODEL_FILE=
# What the model calls itself in API responses (the "model" field). Cosmetic,
# but worth setting to something the calling application expects.
LLM_MODEL_NAME=llm
LLM_PORT=8097
LLM_CTX=8192
# Match this to the CPU you're actually running on (nproc), not the build box.
# Rule of thumb: single-socket → nproc; dual-socket → cores-per-socket.
LLM_THREADS=8
LLM_PARALLEL=1
LLM_MEM_LIMIT=16g
# Thinking / Reasoning mode:
#   0 = Standard Chat Model (default, e.g. Qwen 2.5, Mistral, Llama 3) — direct answers
#   1 = Reasoning Model (e.g. DeepSeek-R1, QwQ, Qwen-Thinking) — enables <think> reasoning tags
LLM_THINKING=0

# ---- Embeddings ----
EMBED_MODEL_FILE=
EMBED_MODEL_NAME=embed
EMBED_PORT=8098
EMBED_CTX=4096
EMBED_THREADS=4
EMBED_MEM_LIMIT=3g
# mean: BGE-M3, nomic-embed-text.  cls: BGE-large-en-v1.5.
# Wrong value != an error — it silently degrades embedding quality. Check the
# embedding model's card/README for which pooling it expects.
EMBED_POOLING=mean

# ---- Reranker (cross-encoder) ----
RERANK_MODEL_FILE=
RERANK_MODEL_NAME=reranker
RERANK_PORT=8099
RERANK_CTX=4096
RERANK_THREADS=4
RERANK_MEM_LIMIT=3g

# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  NUMA — for multi-socket CPUs (dual Xeon, EPYC, etc.)                  ║
# ╚══════════════════════════════════════════════════════════════════════════╝
# Skip this entire section on single-socket machines.

# Set to 1 to run llama-server under `numactl --interleave=all`.
# This interleaves model memory across NUMA nodes so both memory controllers
# feed the CPU in parallel. Benchmarked ~50% faster on dual-socket Xeon.
NUMA_ENABLED=0

# NUMA scheduling mode passed to llama-server's --numa flag.
# "distribute" = spread threads across nodes. Safe on single-socket too.
NUMA_MODE=distribute

# Pin each service to specific CPU cores. Empty = no pinning (OS decides).
# Use `lscpu` to find your NUMA node layout, then pin to one node.
# Example for a 40-core dual-socket box (cores 0-19 on node 0):
#   LLM_CPUSET=0-19
#   EMBED_CPUSET=
#   RERANK_CPUSET=
LLM_CPUSET=
EMBED_CPUSET=
RERANK_CPUSET=

# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  GPU — for NVIDIA GPU offloading                                        ║
# ╚══════════════════════════════════════════════════════════════════════════╝
# Prerequisites on the host:
#   1. NVIDIA GPU drivers installed (nvidia-smi should work)
#   2. NVIDIA Container Toolkit installed (nvidia-ctk)
#   3. CUDA image built: CUDA=1 bash build-and-push.sh
#
# To start GPU services:
#   docker compose --profile gpu up -d
#
# The GPU services use the SAME ports as CPU services. Don't run both at once.

# How many GPUs to expose to each container. "all" or a number like "1".
GPU_COUNT=all

# Layers to offload to GPU. 99 = offload everything (if it fits in VRAM).
# If the model doesn't fit entirely, llama.cpp automatically keeps the
# remaining layers on CPU — no crash, just slower for those layers.
# Set to 0 to keep everything on CPU (useful for benchmarking).
LLM_GPU_LAYERS=99
EMBED_GPU_LAYERS=99
RERANK_GPU_LAYERS=99

# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  EXAMPLES                                                               ║
# ╚══════════════════════════════════════════════════════════════════════════╝
#
# ── Example 1: Simple CPU, 8-core single-socket ──
#   LLM_MODEL_FILE=Mistral-7B-Instruct-v0.3.Q4_K_M.gguf
#   EMBED_MODEL_FILE=bge-m3-Q8_0.gguf
#   RERANK_MODEL_FILE=bge-reranker-v2-m3-Q8_0.gguf
#   LLM_THREADS=8
#   EMBED_THREADS=4
#   RERANK_THREADS=4
#   → docker compose up -d
#
# ── Example 2: 40-core dual-socket Xeon (like dolramp001) ──
#   LLM_MODEL_FILE=Qwen3-8B-Q4_K_M.gguf
#   EMBED_MODEL_FILE=bge-m3-Q8_0.gguf
#   RERANK_MODEL_FILE=bge-reranker-v2-m3-Q8_0.gguf
#   NUMA_ENABLED=1
#   LLM_THREADS=20
#   LLM_CPUSET=0-19
#   EMBED_THREADS=8
#   RERANK_THREADS=8
#   → docker compose up -d
#
# ── Example 3: GPU with NVIDIA RTX/Tesla ──
#   LOCAL_LLM_IMAGE=dlabssg/local-llm:cuda12
#   LLM_MODEL_FILE=Qwen3-8B-Q4_K_M.gguf
#   EMBED_MODEL_FILE=bge-m3-Q8_0.gguf
#   RERANK_MODEL_FILE=bge-reranker-v2-m3-Q8_0.gguf
#   LLM_GPU_LAYERS=99
#   EMBED_GPU_LAYERS=99
#   RERANK_GPU_LAYERS=99
#   LLM_THREADS=8
#   → docker compose --profile gpu up -d
